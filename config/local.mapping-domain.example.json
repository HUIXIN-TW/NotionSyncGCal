{
  "settings": {
    "schemaVersion": 2,
    "ownerUserUuid": "local-user",
    "timeZone": "Australia/Perth",
    "version": 1,
    "updatedAtMs": 0
  },
  "taskSources": [
    {
      "id": "local-task-source",
      "ownerUserUuid": "local-user",
      "lifecycle": "active",
      "version": 1,
      "database": {
        "externalId": "replace_with_your_notion_database_id",
        "url": "https://www.notion.so/replace_with_your_notion_database_id",
        "name": "Tasks"
      },
      "defaults": {
        "goBackDays": 1,
        "goForwardDays": 2,
        "defaultEventLengthMinutes": 60,
        "defaultStartHour": 8
      },
      "propertyMappings": {
        "task": {
          "propertyId": "title-property-id",
          "propertyName": "Task",
          "propertyType": "title"
        },
        "date": {
          "propertyId": "date-property-id",
          "propertyName": "Date",
          "propertyType": "date"
        },
        "location": {
          "propertyId": "location-property-id",
          "propertyName": "Location",
          "propertyType": "place"
        },
        "extraInfo": {
          "propertyId": "extra-info-property-id",
          "propertyName": "Extra Info",
          "propertyType": "rich_text"
        },
        "calendarName": {
          "propertyId": "calendar-property-id",
          "propertyName": "Calendar",
          "propertyType": "select"
        },
        "googleCalendarEventId": {
          "propertyId": "event-id-property-id",
          "propertyName": "GCal Event Id",
          "propertyType": "rich_text"
        },
        "googleCalendarSyncTime": {
          "propertyId": "sync-time-property-id",
          "propertyName": "GCal Sync Time",
          "propertyType": "rich_text"
        },
        "googleCalendarEndDate": {
          "propertyId": "end-date-property-id",
          "propertyName": "GCal End Date",
          "propertyType": "formula"
        },
        "googleCalendarDeleted": {
          "propertyId": "deleted-property-id",
          "propertyName": "GCal Deleted?",
          "propertyType": "checkbox"
        },
        "googleCalendarIcon": {
          "propertyId": "icon-property-id",
          "propertyName": "GCal Icon",
          "propertyType": "formula"
        }
      },
      "createdAtMs": 0,
      "updatedAtMs": 0
    }
  ],
  "calendarMappings": [
    {
      "id": "local-calendar-mapping",
      "ownerUserUuid": "local-user",
      "sourceId": "local-task-source",
      "calendarId": "your_calendar_id@gmail.com",
      "lifecycle": "active",
      "version": 1,
      "createdAtMs": 0,
      "updatedAtMs": 0
    }
  ]
}
